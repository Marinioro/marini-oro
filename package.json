{
  "name": "marini-oro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode teste",
    "typecheck": "tsc --noEmit -p .",
    "build:oficial": "vite build --mode oficial --base /marini-oro/ --outDir dist --emptyOutDir",
    "build:teste": "vite build --mode teste --base /marini-oro/teste/ --outDir dist/teste --emptyOutDir",
    "build:tudo": "npm run typecheck && npm run build:oficial && npm run build:teste"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
